# Copie para .env.local e preencha com os valores do app Web do seu projeto Firebase
# (Console Firebase > Configurações do projeto > Seus apps > SDK setup). Estes valores NÃO são segredos,
# mas ainda assim não devem ser versionados. Chaves de IA NUNCA vão aqui (ver docs/IA.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Região das Cloud Functions (opcional; padrão southamerica-east1)
VITE_FUNCTIONS_REGION=southamerica-east1
# Minutos de inatividade até encerrar a sessão (padrão 30)
VITE_IDLE_TIMEOUT_MINUTES=30
# Use "true" para conectar aos emuladores locais (npm run emulators)
VITE_USE_EMULATORS=false
